# Copy to .env and adjust. Nothing here is required for the default local setup.

# Where the routing config lives (inside the container it is /app/config/gateway.yaml).
GATEWAY_CONFIG_PATH=config/gateway.yaml
# redis://... for real Redis, or memory:// for a throwaway in-process store (needs fakeredis).
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
LOG_JSON=true

# Providers
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Free tier key from https://aistudio.google.com/ (optional; leave empty to skip Gemini)
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint (optional)
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=

# Gateway API keys handed to clients
GATEWAY_DEV_KEY=sk-gw-dev-local-only
GATEWAY_LOADTEST_KEY=sk-gw-loadtest-local-only

# Features
SEMANTIC_CACHE_ENABLED=false
LOG_BODIES=false

# Tracing: leave empty to disable. docker-compose points this at the OTel collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=llm-gateway
